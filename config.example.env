# Copy to config.env and fill in. config.env is private and is not submitted.
DRIVE_FOLDER_ID=<id from the Drive folder URL>
LEARNER_NAME=<your full name>
LEARNER_EMAIL=<email you submit with in Trainer Central>
SENDER_NAME=<same as LEARNER_NAME; used on every dashboard post>
API_BASE=https://trainer-central-assigments-api.onrender.com
