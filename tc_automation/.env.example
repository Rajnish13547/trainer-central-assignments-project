# Copy to .env (chmod 600 .env). NEVER commit or submit the real .env.

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Who am I (Claude matches emails against these) ---
LEARNER_NAME=Your Full Name
LEARNER_EMAIL=you@example.com
# Same sender on every push so the dashboard groups entries under one learner
SENDER_NAME=Your Full Name

# --- Google Drive (shared folder must be "Anyone with the link: Viewer") ---
DRIVE_FOLDER_ID=1u616cv0oZK4wK5EcnxPahgkEi0ypjzvU
GOOGLE_API_KEY=

# --- Trainer Central dashboard API ---
TRAINER_API_BASE=https://trainer-central-assigments-api.onrender.com
# Only if the trainer says POST needs it (sent as x-api-key header). Leave blank otherwise.
TRAINER_API_KEY=
